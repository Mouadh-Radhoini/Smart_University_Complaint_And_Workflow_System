{% extends 'base.html.twig' %}

{% block title %}Complaint #{{ complaint.id }}{% endblock %}

{% block body %}
    <h1>Complaint #{{ complaint.id }}</h1>

    <p><strong>Title:</strong> {{ complaint.title }}</p>
    <p><strong>Description:</strong><br>{{ complaint.description|nl2br }}</p>
    <p><strong>Status:</strong> {{ complaint.status }}</p>
    <p><strong>Created By:</strong>
        {% if complaint.createdBy %}
            {{ complaint.createdBy.fullName }} ({{ complaint.createdBy.email }})
        {% endif %}
    </p>
    <p><strong>Created At:</strong> {{ complaint.createdAt ? complaint.createdAt|date('Y-m-d H:i') : '' }}</p>
    <p><strong>Updated At:</strong> {{ complaint.updatedAt ? complaint.updatedAt|date('Y-m-d H:i') : '' }}</p>

    {% if is_granted('ROLE_ADMIN') %}
        <hr>
        <h2>Update Status</h2>
        <form method="post" action="{{ path('complaint_update_status', {id: complaint.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('update_status' ~ complaint.id) }}">
            <select name="status">
                {% for status in allowed_statuses %}
                    <option value="{{ status }}" {% if status == complaint.status %}selected{% endif %}>{{ status }}</option>
                {% endfor %}
            </select>
            <button type="submit">Update Status</button>
        </form>
    {% endif %}
{% endblock %}

